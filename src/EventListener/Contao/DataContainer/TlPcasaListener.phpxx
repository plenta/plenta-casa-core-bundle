namespace Plenta\CasaCoreBundle\Helper;

use Contao\CoreBundle\DependencyInjection\Attribute\AsCallback;
use Contao\DataContainer;

class TlPcasaListener
{
    #[AsCallback(table: 'tl_pcasa_quarter', target: 'fields.alias.save')]
    public function quarterAlias($value, DataContainer $dc): string
    {
        return 'alias';
    }

    #[AsCallback(table: 'tl_pcasa_targetgroup', target: 'fields.alias.save')]
    public function targetgroupAlias($value, DataContainer $dc): string
    {
        return 'alias';
    }
}
