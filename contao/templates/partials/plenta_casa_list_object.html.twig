{% trans_default_domain 'plenta_casa' %}

{% set url = content_url(jumpTo, {parameters: '/' ~ object.alias}) %}

<div class="object">
    {% block titleImage %}
        {% if object.singleSRC|default and data.size %}
            <a href="{{ url }}" title="{{ 'CASA.show_object'|trans({':name': object.name}) }}" class="image-content">
                {{ content_element('image', {
                    singleSRC: object.singleSRC,
                    size: data.size,
                    sortBy: '',
                    fullsize: false,
                }) }}
            </a>
        {% endif %}
    {% endblock %}

    <div class="main-content">
        {% block title %}
            <div class="title">
                <a href="{{ url }}">{{ object.name }}</a>
            </div>
        {% endblock %}

        {% block meta %}
            {% set meta %}
                {{ object.livingArea }}
                {{ object.rooms }}
                {{ object.floorPosition }}
            {% endset %}

            {% if meta|trim is not empty %}
                <div class="meta">
                    {% if object.livingArea|default %}
                        <span class="area">{{ object.livingArea }} {{ 'CASA.area_unit'|trans }}</span>
                    {% endif %}
                    {% if object.rooms|default %}
                        <span class="rooms">{{ object.rooms }} {{ 'CASA.room_unit'|trans }}</span>
                    {% endif %}
                    {% if object.floorPosition|default %}
                        <span class="floor">{{ object.floorPosition }}</span>
                    {% endif %}
                </div>
            {% endif %}
        {% endblock %}

        {% block address %}
            <div class="address">
                {{ object.address }}
            </div>
        {% endblock %}

        {% block additional %}
        {% endblock %}
    </div>

    <div class="wrapper-content">
        {% block price %}
            <span class="price">{{ object.baseRent }} EUR
            <span class="small">Kaltmiete zzgl. NK</span>
        </span>
        {% endblock %}

        {% block button %}
            <a class="button" href="{{ url }}">Zum Angebot</a>
        {% endblock %}
    </div>
</div>