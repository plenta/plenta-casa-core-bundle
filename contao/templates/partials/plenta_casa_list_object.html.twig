{% trans_default_domain 'plenta_casa' %}

{% set url = content_url(jumpTo, {parameters: '/' ~ object.alias}) %}
{% set image_src = object|casaObjectImage %}

<div class="object{% if object.featured %} object-featured{% endif %}">
    {% if object.featured or object.createdAt|casaIsNew %}
        <div class="badges badges-first">
            {% if object.featured %}
                <span class="badge-featured">{{ 'PLENTA.CASA.badge.featured'|trans({}, 'contao_default') }}</span>
            {% endif %}
            {% if object.createdAt|casaIsNew %}
                <span class="badge-new">{{ 'PLENTA.CASA.badge.new'|trans({}, 'contao_default') }}</span>
            {% endif %}
        </div>
    {% endif %}

    {% block titleImage %}
        {% if image_src and model.size %}
            {% set file_meta = image_src|casaFileMeta %}
            {% set image = figure(image_src, model.size, {
                linkHref: url,
                metadata: {
                    alt: file_meta.alt ?: object.title,
                    title: file_meta.title ?: object.title,
                },
                options: {
                    attr: {class: 'content-image'},
                },
            }) %}
            {% if image %}
                {% use '@Contao/component/_figure.html.twig' %}
                {% with {figure: image} %}{{ block('figure_component') }}{% endwith %}
            {% endif %}
        {% endif %}
    {% endblock %}

    <div class="main-content">
        {% block badges %}
            {% use '@Contao/components/_casa_object_badges.html.twig' %}
            {{ block('object_badges_component') }}
        {% endblock %}

        {% block title %}
            <div class="title">
                <a href="{{ url }}">{{ object.name }}</a>
            </div>
        {% endblock %}

        {% block meta %}
            {% use '@Contao/components/_casa_object_meta.html.twig' %}
            {% set meta_data =
                {
                    livingArea: object.livingArea,
                    rooms: object.rooms,
                    floorPosition: object.floorPosition,
                }
            %}

            {% with {meta_data} %}{{ block('meta_component') }}{% endwith %}
        {% endblock %}

        {% block address %}
            <div class="address">
                {{ object.address }}
            </div>
        {% endblock %}

        {% block additional %}
        {% endblock %}
    </div>

    <div class="wrapper-content">
        {% block price %}
            {% use '@Contao/components/_casa_price_simple.html.twig' %}
            {{ block('price_simple_component') }}
        {% endblock %}

        {% block button %}
            <a class="button" href="{{ url }}">Zum Angebot</a>
        {% endblock %}
    </div>
</div>
