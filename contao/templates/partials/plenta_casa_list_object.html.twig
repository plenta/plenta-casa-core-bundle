{% trans_default_domain 'plenta_casa' %}

{% set url = content_url(jumpTo, {parameters: '/' ~ object.alias}) %}

<div class="object{% if object.featured %} object-featured{% endif %}">
    {% if object.featured or object.createdAt|casaIsNew %}
        <div class="badges badges-first">
            {% if object.featured %}
                <span class="badge-featured">{{ 'PLENTA.CASA.badge.featured'|trans({}, 'contao_default') }}</span>
            {% endif %}
            {% if object.createdAt|casaIsNew %}
                <span class="badge-new">{{ 'PLENTA.CASA.badge.new'|trans({}, 'contao_default') }}</span>
            {% endif %}
        </div>
    {% endif %}

    {% block titleImage %}
        {% if object.singleSRC|default and model.size %}
            {% set file_meta = object.singleSRC|casaFileMeta %}
            {% set image = figure(object.singleSRC, model.size, {
                linkHref: url,
                metadata: {
                    alt: file_meta.alt ?: object.title,
                    title: file_meta.title ?: object.title,
                },
                options: {
                    attr: {class: 'content-image'},
                },
            }) %}
            {% if image %}
                {% use '@Contao/component/_figure.html.twig' %}
                {% with {figure: image} %}{{ block('figure_component') }}{% endwith %}
            {% endif %}
        {% endif %}
    {% endblock %}

    <div class="main-content">
        {% block badges %}
            {% if object.sold|default or object.reserved|default %}
                <div class="badges badges-second">
                    {% if object.sold|default %}
                        <span class="badge-sold">{{ 'PLENTA.CASA.badge.sold'|trans({}, 'contao_default') }}</span>
                    {% endif %}
                    {% if object.reserved|default %}
                        <span class="badge-reserved">{{ 'PLENTA.CASA.badge.reserved'|trans({}, 'contao_default') }}</span>
                    {% endif %}
                </div>
            {% endif %}
        {% endblock %}

        {% block title %}
            <div class="title">
                <a href="{{ url }}">{{ object.name }}</a>
            </div>
        {% endblock %}

        {% block meta %}
            {% set meta %}
                {{ object.livingArea }}
                {{ object.rooms }}
                {{ object.floorPosition }}
            {% endset %}

            {% if meta|trim is not empty %}
                <div class="meta">
                    {% if object.livingArea|default %}
                        <span class="area">{{ object.livingArea|casaFormatNumber }} {{ 'CASA.area_unit'|trans }}</span>
                    {% endif %}
                    {% if object.rooms|default %}
                        <span class="rooms">{{ object.rooms }} {{ 'CASA.room_unit'|trans }}</span>
                    {% endif %}
                    {% if object.floorPosition|default %}
                        <span class="floor">{{ object.floorPosition }}</span>
                    {% endif %}
                </div>
            {% endif %}
        {% endblock %}

        {% block address %}
            <div class="address">
                {{ object.address }}
            </div>
        {% endblock %}

        {% block additional %}
        {% endblock %}
    </div>

    <div class="wrapper-content">
        {% block price %}
            <div class="price-wrapper">
                {% if object.marketing_type == 'RENT' %}
                    <span class="price">{{ object.baseRent|casaFormatNumber }} €</span>
                    <span class="small">Kaltmiete zzgl. NK</span>
                {% elseif object.marketing_type == 'BUY' %}
                    {% if object.priceOnRequest %}
                        <span class="price price-text">{{ 'tl_pcasa_object.priceOnRequest.0'|trans({},
                                'contao_tl_pcasa_object') }}</span>
                    {% elseif object.priceNegotiable %}
                        <span class="price price-text">{{ 'tl_pcasa_object.priceNegotiable.0'|trans({}, 'contao_tl_pcasa_object') }}</span>
                    {% else %}
                        <span class="price">{{ object.price|casaFormatNumber }} €</span>
                        <span class="small">Kaufpreis</span>
                    {% endif %}
                {% endif %}
            </div>
        {% endblock %}

        {% block button %}
            <a class="button" href="{{ url }}">Zum Angebot</a>
        {% endblock %}
    </div>
</div>