{% extends '@Contao/casa/reader/parts/_base.html.twig' %}

{% block part %}
    {% if object.courtage|default or object.courtage_note|default %}
        {{ parent() }}
    {% endif %}
{% endblock %}

{% block content %}
    <dl>
        {% if object.courtage|default %}
            <div>
                <dt class="label">{{ 'PLENTA.CASA.courtage'|trans({}, 'contao_default') }}</dt>
                <dd class="value">{{ object.courtage }}</dd>
            </div>
        {% endif %}
        {% if object.courtage_note|default %}
            <div>
                <dt class="label">{{ object.courtage_note }}</dt>
            </div>
        {% endif %}
    </dl>
{% endblock %}
