{% use '@Contao/component/_headline.html.twig' %}

<div class="part part-{{ part.plenta_casa_readerPartType }}">
    {% set partHeadline = part.headline|deserialize %}
    {% with {headline: {
        text: partHeadline.value,
        tag_name: partHeadline.unit,
    }} %}
        {{ block('headline_component') }}
    {% endwith %}

    {% block content %}
    {% endblock %}
</div>