{% extends '@Contao/casa/reader/parts/_base.html.twig' %}

{% block part %}
    {% if object.propertyCondition|default or object.lastRefurbishment|default or object.qualityOfEquipment|default or object.yearOfConstruction|default or object.yearOfConstructionUnknown|default %}
        {{ parent() }}
    {% endif %}
{% endblock %}

{% block content %}
    {% set fields = [
        {field: 'availableFrom', label: 'tl_pcasa_object.availableFrom.0'},
        {field: 'propertyCondition', label: 'tl_pcasa_object.propertyCondition.0', type: 'reference', reference: 'propertyCondition_options'},
        {field: 'lastRefurbishment', label: 'tl_pcasa_object.lastRefurbishment.0'},
        {field: 'qualityOfEquipment', label: 'tl_pcasa_object.qualityOfEquipment.0', type: 'reference', reference: 'qualityOfEquipment_options'},
        {field: 'yearOfConstructionEngineering', label: 'tl_pcasa_object.yearOfConstructionEngineering.0'},
    ] %}

    <dl class="condition-list">
        {% if object.rented|default %}
            <div>
                <dt class="label">{{ 'tl_pcasa_object.rented.0'|trans({}, 'contao_default') }}</dt>
                <dd class="value">{{ 'PLENTA.CASA.yes'|trans({}, 'contao_default') }}</dd>
            </div>
        {% endif %}

        {% if object.yearOfConstructionUnknown|default %}
            <div>
                <dt class="label">{{ 'tl_pcasa_object.yearOfConstruction.0'|trans({}, 'contao_default') }}</dt>
                <dd class="value">{{ 'PLENTA.CASA.unknown'|trans({}, 'contao_default') }}</dd>
            </div>
        {% elseif object.yearOfConstruction|default %}
            <div>
                <dt class="label">{{ 'tl_pcasa_object.yearOfConstruction.0'|trans({}, 'contao_default') }}</dt>
                <dd class="value">{{ object.yearOfConstruction }}</dd>
            </div>
        {% endif %}

        {% for item in fields %}
            {% set value = attribute(object, item.field) %}
            {% if value|default %}
                <div>
                    <dt class="label">{{ item.label|trans({}, 'contao_default') }}</dt>
                    <dd class="value">
                        {% if item.type|default == 'reference' %}
                            {{ ('tl_pcasa_object.' ~ item.reference ~ '.' ~ value)|trans({}, 'contao_default') }}
                        {% elseif item.type|default == 'date' %}
                            {{ value|date('d.m.Y') }}
                        {% else %}
                            {{ value }}
                        {% endif %}
                    </dd>
                </div>
            {% endif %}
        {% endfor %}
    </dl>
{% endblock %}
