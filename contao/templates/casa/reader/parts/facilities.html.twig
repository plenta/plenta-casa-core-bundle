{% if object.facilities|default or object.bathroomFacilities|default or object.flooring|default %}
    {% embed '@Contao/casa/reader/parts/_base.html.twig' %}

        {% set data = {} %}
        {% for key in ['facilities', 'bathroomFacilities', 'flooring'] %}
            {% set value = attribute(object, key)|default|deserialize %}
            {% if value is not empty %}
                {% set data = data|merge({(key): value}) %}
            {% endif %}
        {% endfor %}

        {% block content %}
            {% for name, array in data %}
                <div>
                <span class="title">{{ ('tl_pcasa_object.' ~ name ~ '.0')|trans([], 'contao_tl_pcasa_object') }}</span>
                <ul>
                    {% for element in array %}
                        <li class="facility facility-{{ element }}">{{ ('tl_pcasa_object.' ~ name ~ '-options.' ~
                            element)|trans([],
                                'contao_tl_pcasa_object') }}</li>
                    {% endfor %}
                </ul>
                </div>
            {% endfor %}
        {% endblock %}

    {% endembed %}
{% endif %}
