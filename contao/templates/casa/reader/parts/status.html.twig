{% extends '@Contao/casa/reader/parts/_base.html.twig' %}

{% block content %}
    {% if object.featured %}
        <span class="featured"></span>
    {% endif %}
    <span class="type">{{ ('PLENTA.CASA.marketing_types.' ~ object.marketing_type)|trans({}, 'contao_default') }}</span>
    <span class="object-type">{{ object.object_type|casaObjectTypeName }}</span>
{% endblock %}