{% extends '@Contao/casa/reader/parts/_base.html.twig' %}

{% block part %}
    {% if object.row().multiSRC or object.row().singleSRC %}
        {{ parent() }}
    {% endif %}
{% endblock %}

{% block content %}
    {% set gallery_images = object.multiSRC|default
        ? object.multiSRC|casaMergeImages(object.singleSRC)
        : serialize([object.singleSRC])
    %}

    {% if gallery_images %}
        {{ content_element('gallery', {
            multiSRC: gallery_images,
            size: data.size,
            fullsize: data.fullsize,
            sortBy: '',
        }) }}
    {% endif %}
{% endblock %}
