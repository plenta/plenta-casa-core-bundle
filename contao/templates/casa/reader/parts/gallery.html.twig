{% extends '@Contao/casa/reader/parts/_base.html.twig' %}

{% block part %}
    {% if object.row().multiSRC or object.row().singleSRC %}
        {{ parent() }}
    {% endif %}
{% endblock %}

{% block content %}
    {% set single_src = object.row().singleSRC %}
    {% set multi_src = object.row().multiSRC %}

    {% if multi_src %}
        {% set gallery_images = multi_src|casaMergeImages %}
    {% elseif single_src %}
        {% set gallery_images = null|casaMergeImages(single_src) %}
    {% endif %}

    {% if gallery_images|default %}
        {{ content_element('gallery', {
            multiSRC: gallery_images,
            size: data.size,
            fullsize: data.fullsize,
            sortBy: '',
        }) }}
    {% endif %}
{% endblock %}