{% extends '@Contao/casa/reader/parts/_base.html.twig' %}

{% block part %}
    {% if object.row().multiSRC %}
        {{ parent() }}
    {% endif %}
{% endblock %}

{% block content %}
    {% if object.multiSRC|default %}
        {% set gallery_images = object.multiSRC|casaMergeImages(object.singleSRC) %}

        {{ content_element('gallery', {
            multiSRC: gallery_images,
            size: data.size,
            fullsize: data.fullsize,
            sortBy: '',
        }) }}
    {% endif %}
{% endblock %}
