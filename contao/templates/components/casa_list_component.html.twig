{% use '@Contao/component/_headline.html.twig' %}

<div {{ attributes|raw }}>
    {% set headline = {
        text: (model.headline|deserialize).value,
        tag_name: (model.headline|deserialize).unit,
        attributes: attrs(headline.attributes|default).addClass('headline'),
    } %}

    {% if headline.text %}
        {{ block('headline_component') }}
    {% endif %}

    {% block content %}
        <div class="objects">
            {% for object in objects|default %}
                {{ include('@Contao/' ~ ((object.object_type|casaObjectType).template|default
                    ('partials/plenta_casa_list_object')) ~ '.html.twig') }}
            {% else %}
                {{ 'PLENTA.CASA.empty_list.'|trans({}, 'contao_default') }}
            {% endfor %}

            {% if pagination %}
                {{ include('@Contao/components/_pagination_live.html.twig', {pagination}) }}
            {% endif %}
        </div>
    {% endblock %}
</div>
