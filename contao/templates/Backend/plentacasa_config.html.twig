{% extends "@Contao/be_main" %}

{% block main_content %}
    <div class="be_plentacasa_config">
        <div class="tile-container">
            {% for table in tables %}
            <div class="item {{ table.name }}">
                <a href="{{ backend_route }}{{ table.href }}" title="{{ table.description }}" class="title">{{ table.label }}</a>
                <span class="description">{{ table.description }}</span>
            </div>
            {% endfor %}
        </div>

        <div class="credits">
            <p>
                {{ version }} - <a href="{{ changelog }}" title="{{ 'PLENTA.CASA.changelog_title'|trans({}, 'plenta_casa_dashboard') }}" target="_blank" rel="noreferrer noopener">{{ 'PLENTA.CASA.changelog'|trans({}, 'plenta_casa_dashboard') }}</a>
            </p>
        </div>
    </div>
{% endblock %}