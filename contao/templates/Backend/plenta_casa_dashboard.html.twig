{% trans_default_domain 'plenta_casa_dashboard' %}

<div class="plenta_casa_dashboard">

    {% block headline %}
        <h2 class="greeting">{{ salutation }} {{ username }}</h2>
    {% endblock %}

    {% block error %}
    {% endblock %}

    {% block main_content %}
        <div class="dashboard">
            <div class="tile objects">
                <span class="numbers">{{ objectStats.published }} / {{ objectStats.total }}</span>
                <span class="description">{{ 'PLENTA.CASA.objects'|trans({}, 'plenta_casa_dashboard') }}</span>
            </div>

            <div class="tile requests">
                <span class="numbers">0</span>
                <span class="description">{{ 'PLENTA.CASA.requests'|trans({}, 'plenta_casa_dashboard') }}</span>
            </div>

            <div class="tile future">
                <span class="numbers">{{ 'PLENTA.CASA.future'|trans({}, 'plenta_casa_dashboard') }}</span>
                <span class="description"><a href="https://github.com/plenta/plenta-casa-core-bundle/issues" title="{{ 'PLENTA.CASA.future_link'|trans({}, 'plenta_casa_dashboard') }}" target="_blank" rel="noreferrer noopener">{{ 'PLENTA.CASA.future_link'|trans({}, 'plenta_casa_dashboard') }}</a></span>
            </div>
        </div>

        <div class="credits">
            <p>
                {{ version }} - <a href="{{ changelog }}" title="{{ 'PLENTA.CASA.changelog_title'|trans({}, 'plenta_casa_dashboard') }}" target="_blank" rel="noreferrer noopener">{{ 'PLENTA.CASA.changelog'|trans({}, 'plenta_casa_dashboard') }}</a>
            </p>
        </div>

    {% endblock %}
</div>
