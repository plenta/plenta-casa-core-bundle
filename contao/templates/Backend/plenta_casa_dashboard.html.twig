{% trans_default_domain 'plenta_casa_dashboard' %}

<div class="plenta_casa_dashboard">

    {% block headline %}
        <h2 class="greeting">{{ salutation }} {{ username }}</h2>
    {% endblock %}

    {% block error %}
    {% endblock %}

    {% block main_content %}
        <div class="dashboard">
            <div class="tile objects">
                <a href="#">Block 1</a>
                <span class="description">Objekte online</span>

            </div>

            <div class="tile">
                Block 3
            </div>

            <div class="tile">
                Block 3
            </div>
        </div>

        <div class="credits">
            <p>
                {{ version }} - <a href="{{ changelog }}" title="{{ 'PLENTA.CASA.changelog_title'|trans({}, 'plenta_casa_dashboard') }}" target="_blank" rel="noreferrer noopener">{{ 'PLENTA.CASA.changelog'|trans({}, 'plenta_casa_dashboard') }}</a> - {{ manufacturer|raw }}
            </p>
        </div>

    {% endblock %}
</div>
