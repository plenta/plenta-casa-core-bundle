{% use '@Contao/component/_figure.html.twig' %}

{% set marketing_type = ('PLENTA.CASA.marketing_types.' ~ property.marketing_type)|trans({}, 'contao_default') %}
{% set object_type = property.object_type|casaObjectTypeName %}

<table class="plenta_casa_property_listing">
    <tbody>
    <tr>
        <td class="image" rowspan="4">
            {% if image %}
                {% set fig = figure(image, [100, 100, 'crop']) %}

                {% if fig %}
                    {% with {figure: fig} %}{{ block('figure_component') }}{% endwith %}
                {% endif %}
            {% endif %}
        </td>
        <td>
            <span class="title">{{ property.title|default('Kein Titel vergeben') }}</span>
        </td>
    </tr>
    <tr>
        <td>
            <span class="address">{{ property.street }} {{ property.housenumber }}, {{ property.postal }} {{ property.city }}</span>
        </td>
    </tr>
    <tr>
        <td>
            <span class="badge marketing-type" title="Vermarktungsart: {{ marketing_type }}">{{ marketing_type }}</span>
            <span class="badge object-type" title="Objekttyp: {{ object_type }}">{{ object_type }}</span>
            <span class="badge">Maße</span>
            <span class="badge">Kosten</span>
        </td>
    </tr>
    <tr>
        <td>
            <span class="leads">{{ leads }}</span>
        </td>
    </tr>
    </tbody>
</table>
