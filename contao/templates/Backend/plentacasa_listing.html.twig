    <tr>
        <th colspan="3">{{ property.title }} <span class="tl_gray">[{{ property.title }}]</span></th>
    </tr>
    </thead>
    <tbody>
    <tr>
        <td class="image" rowspan="3">
            {% if image %}
                {{ contao_figure(image, [80, 80, 'proportional']) }}
            {% endif %}
