<table class="plenta_casa_property_listing">
    <thead>
    <tr>
        <th colspan="3">
            <span class="tl_gray">
                    {{ property.street }} {{ property.housenumber }},
                    {{ property.postal }} {{ property.city }}
            </span><br>
            {{ property.title }}
        </th>
    </tr>
    </thead>
    <tbody>
    <tr>
        <td class="image" rowspan="4">
            {% if image %}
                {{ contao_figure(image, [80, 80, 'crop']) }}
            {% endif %}
        </td>
        <th scope="row">Vermarktungsart:</th>
        <td>{{ ('PLENTA.CASA.marketing_types.' ~ property.marketing_type)|trans({}, 'contao_default') }}</td>
    </tr>
    <tr>
        <th scope="row">Objekttyp:</th>
        <td>{{ property.object_type|casaObjectTypeName }}</td>
    </tr>
    <tr>
        <th scope="row">Objektnummer:</th>
        <td>{{ property.unit_id ?: '-' }}</td>
    </tr>
    <tr>
        <th scope="row">?:</th>
        <td>?</td>
    </tr>
    </tbody>
</table>
