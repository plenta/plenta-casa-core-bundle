{% set marketingType = ('PLENTA.CASA.marketing_types.' ~ property.marketing_type)|trans({}, 'contao_default') %}
{% set objectType = property.object_type|casaObjectTypeName %}

<table class="plenta_casa_property_listing">
    <tbody>
    <tr>
        <td class="image" rowspan="3">
            {% if image %}
                {{ contao_figure(image, [100, 100, 'crop']) }}
            {% endif %}
        </td>
        <td>
            <span class="title">{{ property.title|default('Kein Titel vergeben') }}</span>
        </td>
    </tr>
    <tr>
        <td>
            <span class="address">{{ property.street }} {{ property.housenumber }}, {{ property.postal }} {{ property.city }}</span>
        </td>
    </tr>
    <tr>
        <td>
            <span class="badge" title="Vermarktungsart: {{ marketingType }}">{{ marketingType }}</span>
            <span class="badge object-type" title="Objekttyp: {{ objectType }}">{{ objectType }}</span>
        </td>
    </tr>
    </tbody>
</table>
