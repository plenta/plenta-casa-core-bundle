{% extends "@Contao/content_element/_base.html.twig" %}

{% set attributes = attrs().setIfExists('data-id', data.id).mergeWith(attributes|default) %}

{% set headline = headline|merge({
    'attributes': attrs(headline.attributes|default).addClass('headline')
}) %}

{% block content %}
    <div class="objects">
        {% for object in objects %}
            {{ include('@Contao/' ~ ((object.object_type|casaObjectType).template|default
                ('partials/plenta_casa_list_object')) ~ '.html.twig') }}
        {% else %}
            {{ 'PLENTA.CASA.empty_list.'|trans({}, 'contao_default') }}
        {% endfor %}
    </div>

    {{ pagination|default|raw }}

{% endblock %}