{% extends '@Contao/content_element/_base.html.twig' %}

{% if object.featured %}
    {% set attributes = attrs()
        .addClass('object-featured')
        .addClass(cssClasses|default([]))
    %}
{% endif %}

{% block content %}
    {% for part in data.plenta_casa_readerParts|deserialize %}
        {% if part.plenta_casa_readerPartType %}
        {{ include('@Contao/' ~ part.plenta_casa_readerPartTpl|default('casa/reader/parts/' ~ part.plenta_casa_readerPartType) ~ '.html.twig') }}
        {% endif %}
    {% endfor %}
{% endblock %}
