{
  "name": "plenta/plenta-casa-core-bundle",
  "type": "contao-bundle",
  "license": "proprietary",
  "version": "1.0.1",
  "authors": [
    {
      "name": "Plenta.io",
      "homepage": "https://plenta.io",
      "email": "hallo@plenta.io"
    }
  ],
  "require": {
    "php": "^8.3",
    "contao/core-bundle": "^5.7",
    "contao/manager-plugin": "^2.6",
    "doctrine/dbal": "^3.7 || ^4.3",
    "mvo/contao-group-widget": "^1.6",
    "symfony/asset": "^7.4",
    "symfony/config": "^7.4",
    "symfony/dependency-injection": "^7.4",
    "symfony/event-dispatcher": "^7.4",
    "symfony/event-dispatcher-contracts": "^3.6",
    "symfony/form": "^7.4",
    "symfony/http-foundation": "^7.4",
    "symfony/http-kernel": "^7.4",
    "symfony/options-resolver": "^7.4",
    "symfony/routing": "^7.4",
    "symfony/security-core": "^7.4",
    "symfony/stimulus-bundle": "^2.31",
    "symfony/translation-contracts": "^3.6",
    "symfony/ux-live-component": "^3.0",
    "symfony/ux-twig-component": "^3.1",
    "symfonycasts/dynamic-forms": "^0.2.0",
    "twig/twig": "^3.21",
    "ext-intl": "*"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^v3.86.0",
    "plenta/contao-build-tools": "@dev",
    "contao/manager-bundle": "^5.7"
  },
  "autoload": {
    "psr-4": {
      "Plenta\\CasaCoreBundle\\": "src"
    }
  },
  "extra": {
    "contao-manager-plugin": "Plenta\\CasaCoreBundle\\ContaoManager\\Plugin"
  },
  "config": {
    "allow-plugins": {
      "composer/package-versions-deprecated": true,
      "contao-components/installer": true,
      "contao/manager-plugin": true,
      "contao-community-alliance/composer-plugin": true,
      "php-http/discovery": true,
      "plenta/contao-build-tools": true
    }
  }
}
