{
  "name": "plenta/plenta-casa-core-bundle",
  "type": "contao-bundle",
  "license": "proprietary",
  "authors": [
    {
      "name": "Plenta.io",
      "homepage": "https://plenta.io",
      "email": "hallo@plenta.io"
    }
  ],
  "require": {
    "php": "^8.3",
    "contao/core-bundle": "^5.6",
    "symfony/form": "^7.3",
    "symfony/stimulus-bundle": "^2.31"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^v3.86.0"
  },
  "autoload": {
    "psr-4": {
      "Plenta\\CasaCoreBundle\\": "src"
    }
  },
  "extra": {
    "contao-manager-plugin": "Plenta\\CasaCoreBundle\\ContaoManager\\Plugin"
  },
  "config": {
    "allow-plugins": {
      "composer/package-versions-deprecated": true,
      "contao-components/installer": true,
      "contao/manager-plugin": true,
      "contao-community-alliance/composer-plugin": true,
      "php-http/discovery": true
    }
  }
}
